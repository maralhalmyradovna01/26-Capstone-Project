<!DOCTYPE html>
<html lang="tk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posty Redaktirlemek</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="form-body">

    <div class="form-card">
        <h2>Posty Redaktirlemek</h2>
        <form action="/edit/<%= post.id %>" method="POST" class="post-form">
            <div class="form-group">
                <label for="title">Sözbaşy (Title)</label>
                <input type="text" id="title" name="title" value="<%= post.title %>" required>
            </div>

            <div class="form-group">
                <label for="content">Mazmuny (Content)</label>
                <!-- Boshluk syçramazlygy üçin textarea içindäki ýazgy yapysyk durmaly -->
                <textarea id="content" name="content" rows="6" required><%= post.content %></textarea>
            </div>

            <div class="form-group">
                <label for="date">Sene (Date)</label>
                <input type="text" id="date" name="date" value="<%= post.date %>">
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Ýatda sakla</button>
                <a href="/" class="btn btn-secondary">Yza</a>
            </div>
        </form>
    </div>

</body>
</html>